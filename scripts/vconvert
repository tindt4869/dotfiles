#!/bin/bash

# Kiểm tra đủ tham số đầu vào
if [ $# -lt 2 ]; then
    echo "Cách dùng:"
    echo "  vconvert -c input.ts   # (Copy) Nhanh nhất, không nén"
    echo "  vconvert -g input.ts   # (GPU)  Tốc độ cao, file vừa"
    echo "  vconvert -s input.ts   # (Size) File nhỏ nhất, dùng CPU"
    exit 1
fi

MODE=$1
INPUT=$2
FILENAME=$(basename -- "$INPUT")
FILENAME_NO_EXT="${FILENAME%.*}"
OUTPUT="${FILENAME_NO_EXT}.mp4"

# Kiểm tra file input có tồn tại không
if [ ! -f "$INPUT" ]; then
    echo "Lỗi: File '$INPUT' không tồn tại!"
    exit 1
fi

# Chống ghi đè nếu trùng tên
if [ -e "$OUTPUT" ]; then
    OUTPUT="${FILENAME_NO_EXT}_conv_$(date +%M%S).mp4"
fi

case $MODE in
    -c)
        echo "--- Chế độ: COPY (Siêu nhanh) ---"
        ffmpeg -i "$INPUT" -c copy "$OUTPUT"
        ;;
    -g)
        echo "--- Chế độ: GPU (AMD VAAPI) ---"
        ffmpeg -vaapi_device /dev/dri/renderD128 -i "$INPUT" \
            -vf 'format=nv12,hwupload,scale_vaapi=w=1280:h=720' \
            -c:v hevc_vaapi -rc_mode VBR -b:v 500k -maxrate 4M -quality 1 \
            -c:a aac -b:a 128k "$OUTPUT"
        ;;
    -s)
        echo "--- Chế độ: SIZE (CPU x265 - Cực nhẹ) ---"
        # Dùng preset faster để cân bằng thời gian và dung lượng
        ffmpeg -i "$INPUT" -c:v libx265 -crf 28 -preset faster \
            -c:a aac -b:a 128k "$OUTPUT"
        ;;
    *)
        echo "Lỗi: Tham số không hợp lệ ($MODE). Dùng -c, -g hoặc -s."
        exit 1
        ;;
esac

if [ $? -eq 0 ]; then
    echo "--- Xong! File: $OUTPUT ---"
else
    echo "--- Lỗi trong quá trình xử lý ---"
fi
