#!/bin/bash

# 1. Kiểm tra tham số đầu vào
if [ $# -lt 2 ]; then
    echo "Cách dùng: vconvert [MODE] [INPUT]"
    echo "  -c : Copy (Giữ nguyên chất lượng, cực nhanh)"
    echo "  -g : GPU AMD (Dùng phần cứng Vega 7 - Nhanh & Đẹp)"
    echo "  -s : CPU x265 (Nén sâu nhất, tốn tài nguyên CPU)"
    exit 1
fi

MODE="$1"
INPUT="$2"

# 2. Kiểm tra file input có tồn tại không
if [ ! -f "$INPUT" ]; then
    echo "Lỗi: File '$INPUT' không tồn tại!"
    exit 1
fi

# 3. Trích xuất tên file và tạo tên file đầu ra
FILENAME=$(basename -- "$INPUT")
FILENAME_NO_EXT="${FILENAME%.*}"
OUTPUT="${FILENAME_NO_EXT}.mp4"

# 4. Chống ghi đè (Nếu trùng thì thêm timestamp)
if [ -e "$OUTPUT" ]; then
    OUTPUT="${FILENAME_NO_EXT}_$(date +%H%M%S).mp4"
fi

# 5. Xử lý logic theo từng chế độ
case "$MODE" in
    -c)
        echo "--- Đang thực hiện: COPY ---"
        ffmpeg_params=(
            -i "$INPUT"
            -c copy
            "$OUTPUT"
        )
        ;;
        
    -g)
        echo "--- Đang thực hiện: GPU AMD (CQP Mode) ---"
        ffmpeg_params=(
            -vaapi_device /dev/dri/renderD128
            -i "$INPUT"
            -vf "format=nv12,hwupload"
            -c:v hevc_vaapi
            -rc_mode CQP
            -qp 25
            -c:a aac
            -b:a 128k
            "$OUTPUT"
        )
        ;;
        
    -s)
        echo "--- Đang thực hiện: CPU x265 (Slow) ---"
        ffmpeg_params=(
            -i "$INPUT"
            -c:v libx265
            -crf 24
            -preset slow
            -c:a aac
            -b:a 128k
            "$OUTPUT"
        )
        ;;
        
    *)
        echo "Lỗi: Chế độ '$MODE' không hợp lệ. Hãy dùng -c, -g, hoặc -s."
        exit 1
        ;;
esac

# 6. Thực thi lệnh FFmpeg với mảng đã chuẩn bị
ffmpeg "${ffmpeg_params[@]}"

# 7. Kiểm tra kết quả
if [ $? -eq 0 ]; then
    echo "------------------------------------------"
    echo "THÀNH CÔNG! File đầu ra: $OUTPUT"
    echo "------------------------------------------"
else
    echo "------------------------------------------"
    echo "LỖI: Quá trình xử lý thất bại."
    # Xóa file lỗi nếu có để tránh rác ổ cứng
    [ -f "$OUTPUT" ] && rm "$OUTPUT"
    echo "------------------------------------------"
fi
